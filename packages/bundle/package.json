{
  "name": "@libra-tools/dsh-bundle",
  "version": "0.1.0",
  "description": "Audited Libra Memory recall adapter for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "libra",
    "memory"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libra-tools/deepseek-harness-libra-plugin.git",
    "directory": "packages/bundle"
  },
  "bugs": {
    "url": "https://github.com/libra-tools/deepseek-harness-libra-plugin/issues"
  },
  "homepage": "https://github.com/libra-tools/deepseek-harness-libra-plugin#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:dist": "node ../../scripts/build-bundle-dist.mjs && cp lib/index.d.ts dist/index.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@libra/dsh-bridge-client": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true }
  },
  "dshCompatibility": {
    "release": "v0.1.2-alpha.1",
    "commit": "cd5ef8148158c3a752a658978873241fdf8e2bbc"
  }
}
